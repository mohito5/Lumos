{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "src/features/profile/utils/opencv/cv.d.ts"
, "src/shared/ui/Header/Header.jsx", "src/shared/ui/ActionsButtons/ActionButtons.jsx", "src/shared/ui/ActionsButtons/BackButton.jsx", "src/shared/ui/ActionsButtons/FilterButton.jsx"  ]
}
