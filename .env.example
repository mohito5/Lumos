# Скопируй этот файл в .env и заполни реальными значениями для локальной
# разработки. В продакшене (Cloudflare Pages) эти же имена задаются в
# Settings → Environment variables — .env туда не деплоится (см. .gitignore).
#
# ВАЖНО: Vite пробрасывает в клиентский бандл только переменные с префиксом
# VITE_ — без него import.meta.env их просто не увидит.

# DSN проекта Sentry (или self-hosted GlitchTip и т.п.) для мониторинга
# ошибок в production — см. src/core/services/errorTracking.ts. Не задан —
# мониторинг тихо остаётся выключенным (no-op), приложение работает как
# раньше.
VITE_SENTRY_DSN=
